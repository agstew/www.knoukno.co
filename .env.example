NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:local-dev-only-change-me@localhost:5432/knoukno
DATABASE_SSL=false
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Resend: verification and password-reset email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kno U Kno <noreply@example.com>

# One-time PayPal checkout; each order buys one selected tier
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
# Example: [{"id":"starter","name":"Starter","description":"Starter access","amount":"9.99","features":["Feature one"]},{"id":"growth","name":"Growth","amount":"29.99","features":["Feature one","Feature two"]}]
PAYPAL_TIERS=

# Docker Compose Postgres
POSTGRES_DB=knoukno
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
